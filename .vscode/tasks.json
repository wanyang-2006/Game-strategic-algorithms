{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "${workspaceFolder}\\Resources\\jsoncpplib\\jsoncpp-master\\src\\lib_json\\json_reader.cpp",
                "${workspaceFolder}\\Resources\\jsoncpplib\\jsoncpp-master\\src\\lib_json\\json_value.cpp",
                "${workspaceFolder}\\Resources\\jsoncpplib\\jsoncpp-master\\src\\lib_json\\json_writer.cpp",
                "-I${workspaceFolder}",
                "-I${workspaceFolder}\\Resources\\jsoncpplib\\jsoncpp-master\\include",
                "-o",
				"${env:TEMP}\\active.exe",
				"-fexec-charset=UTF-8"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}