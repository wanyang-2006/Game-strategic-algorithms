          </font></td>
        </tr></tbody></table></td>
      </tr></tbody></table>
    </td>
    <td>&nbsp;</td>
  </tr></tbody></table>
  <script type="text/javascript"><!--

var PING_INTERVAL = 45000;

function ping() {
	$.ajax({
		url: "/ping.jsp",
		method: "POST",
		dataType: "text",
		success: function() {
			setTimeout(ping, PING_INTERVAL);
		},
		error: function() {
			setTimeout(ping, 1000);
		}
	});
}

setTimeout(ping, PING_INTERVAL);

  --></script> 
</body></html>